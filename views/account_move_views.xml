<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_debit_note" model="ir.ui.view">
        <field name="name">account.move.form.inherit.debit.note</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            
            <xpath expr="//field[@name='move_type']" position="after">
                <field name="is_debit_note" invisible="1"/>
            </xpath>

            <xpath expr="//sheet" position="before">
                <div class="alert alert-info mb-0" role="alert" invisible="not is_debit_note">
                    <strong>Documento de Retificação:</strong> Esta é uma Nota de Débito .
                </div>
            </xpath>

            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="debit_origin_id" 
                       string="Fatura de Origem (AGT)"
                       invisible="not is_debit_note" 
                       required="is_debit_note"
                       readonly="state != 'draft'"
                       placeholder="Selecione a fatura confirmada que deu origem a este acréscimo..."/>
            </xpath>

        </field>
    </record>
</odoo>
