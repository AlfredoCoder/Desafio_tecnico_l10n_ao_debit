<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_customer_debit_note" model="ir.actions.act_window">
        <field name="name">Notas de Débito de Clientes</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="view_id" ref="account.view_invoice_tree"/>
        <field name="search_view_id" ref="account.view_account_invoice_filter"/>
        <field name="domain">[('move_type', '=', 'out_invoice'), ('is_debit_note', '=', True)]</field>
        <field name="context">{'default_move_type': 'out_invoice', 'default_is_debit_note': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Criar a primeira Nota de Débito de Cliente
            </p>
            <p>
                As Notas de Débito de cliente registam acréscimos de cobrança  vinculados a faturas anteriores.
            </p>
        </field>
    </record>

    
    <menuitem id="menu_action_customer_debit_note"
              name="Notas de Débito"
              parent="account.menu_finance_receivables"
              action="action_customer_debit_note"
              sequence="2"/>

</odoo>
